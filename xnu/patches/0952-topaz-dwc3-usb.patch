From 394f18bc28471928374659102837461928374610 Mon Sep 17 00:00:00 2001
From: Makr <ngrom33@gmail.com>
Date: Fri, 23 Oct 2026 18:44:00 +0300
Subject: [PATCH] topaz: 0952 DWC3 USB CDC-ECM support for SM6225

Enable USB device mode and networking for topaz (SM6225).
Map DWC3 at 0x04e00000 and QSCRATCH wrapper at 0x04ef8800.
Trigger probe when sweetusb boot-arg is present or sweethw=2.
---
 bsd/dev/sweet_ufs.c |  7 ++++++-
 bsd/dev/sweet_usb.c | 41 +++++++++++++++++++++++++++++++++--------
 2 files changed, 39 insertions(+), 9 deletions(-)

diff --git a/bsd/dev/sweet_ufs.c b/bsd/dev/sweet_ufs.c
index b7be070..c81a29f 100644
--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -664,7 +664,12 @@ sweet_ufs_init(void)
 	int hw = 0;
 	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
 	sweet_touch_init();
 	sweet_keys_init();
-	if (hw == 1) {
+	int usb = 0;
+	(void)PE_parse_boot_argn("sweetusb", &usb, sizeof(usb));
+	if (hw == 1 || hw == 2 || usb > 0) {
 		sweet_usb_probe();
 	} else {
 		printf("SWEET UFS: USB skipped (topaz, sweethw=0)\n");
diff --git a/bsd/dev/sweet_usb.c b/bsd/dev/sweet_usb.c
index a1948df..d891bca 100644
--- a/bsd/dev/sweet_usb.c
+++ b/bsd/dev/sweet_usb.c
@@ -37,8 +37,11 @@ extern ppnum_t pmap_find_phys(pmap_t pmap, addr64_t va);
 #define GCC_USB30_PRIM_GDSCR    0x0f004         /* bit 31: power on */
 #define CBCR_CLK_OFF            (1u << 31)
 
+#define DWC3_PA_TOPAZ           0x04e00000
+#define QSCRATCH_PA_TOPAZ       0x04ef8800
+
 static const struct {
 	const char *name;
 	uint32_t    off;
@@ -48,6 +51,8 @@ static const struct {
 	{ "clkref", 0x8c010 },
 };
 
+static bool usb_is_topaz;
+
 #define DWC3_PA                 0x0a600000
 #define DWC3_SIZE               0x0000d000
 #define QUSB2_PA                0x088e2000
@@ -58,6 +63,7 @@ sweet_usb_probe(void)
 {
 	int enabled = 1;
-	uint32_t gdscr, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
+	uint32_t gdscr = 0, cbcr[sizeof(usb_cbcr) / sizeof(usb_cbcr[0])];
 	bool clocks_on = true;
 
 	/* sweetusb=0 off, 1 (default) report state only, 2 also start the USB device */
@@ -66,6 +72,21 @@ sweet_usb_probe(void)
 	if (!enabled) {
 		return;
 	}
+	int hw = 0;
+	(void)PE_parse_boot_argn("sweethw", &hw, sizeof(hw));
+	usb_is_topaz = (hw != 1);
+
+	vm_offset_t dwc = 0;
+	if (usb_is_topaz) {
+		dwc = ml_io_map(DWC3_PA_TOPAZ, DWC3_SIZE);
+		if (dwc == 0) {
+			printf("SWEET USB: topaz DWC3 map failed\n");
+			return;
+		}
+		printf("SWEET USB: topaz DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x\n",
+		    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118));
+	} else {
 	vm_offset_t gcc = ml_io_map(GCC_PA, GCC_SIZE);
 	if (gcc == 0) {
 		printf("SWEET USB: GCC map failed\n");
@@ -82,7 +103,7 @@ sweet_usb_probe(void)
 		printf("SWEET USB: controller unpowered or unclocked; DWC3 not read\n");
 		return;
 	}
-	vm_offset_t dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
+	dwc = ml_io_map(DWC3_PA, DWC3_SIZE);
 	if (dwc == 0) {
 		printf("SWEET USB: DWC3 map failed\n");
 		return;
@@ -90,6 +111,7 @@ sweet_usb_probe(void)
 	printf("SWEET USB: DWC3 GSNPSID 0x%08x GCTL 0x%08x GSTS 0x%08x GUSB2PHYCFG 0x%08x\n",
 	    usb_rd(dwc, 0xc120), usb_rd(dwc, 0xc110), usb_rd(dwc, 0xc118), usb_rd(dwc, 0xc200));
+	}
 	printf("SWEET USB: DWC3 DCFG 0x%08x DCTL 0x%08x DEVTEN 0x%08x DSTS 0x%08x DALEPENA 0x%08x\n",
 	    usb_rd(dwc, 0xc700), usb_rd(dwc, 0xc704), usb_rd(dwc, 0xc708), usb_rd(dwc, 0xc70c),
 	    usb_rd(dwc, 0xc720));
@@ -101,6 +123,9 @@ sweet_usb_probe(void)
 	if (enabled >= 2) {
 		sweet_usb_gadget_start(dwc);
 	}
+	if (usb_is_topaz) {
+		return;
+	}
 	if (cbcr[5] & CBCR_CLK_OFF) {
 		printf("SWEET USB: ahb2phy clock off; QUSB2 PHY not read\n");
 		return;
@@ -491,7 +516,7 @@ sweet_usb_gadget_start(vm_offset_t dwc)
 	dwc_wr(DALEPENA, 0x3);
 	ud_start_setup();
 
-	vm_offset_t qs = ml_io_map(QSCRATCH_PA, 0x100);
+	vm_offset_t qs = ml_io_map(usb_is_topaz ? QSCRATCH_PA_TOPAZ : QSCRATCH_PA, 0x100);
 	if (qs != 0) {
 		uint32_t hs = usb_rd(qs, QSCRATCH_HS_PHY_CTRL), ss = usb_rd(qs, QSCRATCH_SS_PHY_CTRL);
 		printf("SWEET USB: QSCRATCH HS_PHY_CTRL 0x%08x SS_PHY_CTRL 0x%08x GENERAL_CFG 0x%08x\n",
-- 
2.43.0
