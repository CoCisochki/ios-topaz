From 784f18bc1928374a5e6d01928471928374659102 Mon Sep 17 00:00:00 2001
From: Makr <ngrom33@gmail.com>
Date: Fri, 23 Oct 2026 17:40:00 +0300
Subject: [PATCH] topaz: 0951 grant all privileges in permissive sandbox policy

In permissive mode without Apple entitlements and SIP, daemons such as
logd (PRIV_GLOBAL_PROC_INFO 1002), rapportd (PRIV_NET_PRIVILEGED_NECP_MATCH 12000),
identityservicesd (PRIV_NET_PRIVILEGED_NECP_POLICIES 12001), and symptomsd
(PRIV_NET_QOS_MARKING 10003) were denied privileges by sweet_sandbox_priv_grant.
Grant all requested privileges unconditionally to prevent daemon IPC and network errors.
---
 bsd/kern/sweet_amfi.c | 21 +--------------------
 1 file changed, 1 insertion(+), 20 deletions(-)

diff --git a/bsd/kern/sweet_amfi.c b/bsd/kern/sweet_amfi.c
index 8c91d4e..5f31a0b 100644
--- a/bsd/kern/sweet_amfi.c
+++ b/bsd/kern/sweet_amfi.c
@@ -323,26 +323,7 @@ static struct {
 static int sweet_priv_logged_count;
 
 static int
-sweet_sandbox_priv_grant(kauth_cred_t cred __unused, int priv)
-{
-	if (priv == PRIV_WORK_INTERVAL) {
-		return 0;
-	}
-	char name[20];
-	proc_selfname(name, sizeof(name));
-	for (int i = 0; i < sweet_priv_logged_count; i++) {
-		if (sweet_priv_logged[i].priv == priv &&
-		    strncmp(sweet_priv_logged[i].name, name, sizeof(name)) == 0) {
-			return EPERM;
-		}
-	}
-	if (sweet_priv_logged_count < SWEET_PRIV_LOG_MAX) {
-		sweet_priv_logged[sweet_priv_logged_count].priv = priv;
-		strlcpy(sweet_priv_logged[sweet_priv_logged_count].name, name, sizeof(name));
-		sweet_priv_logged_count++;
-		printf("SWEET Sandbox: %s privilege %d denied\n", name, priv);
-	}
-	return EPERM;
+sweet_sandbox_priv_grant(kauth_cred_t cred __unused, int priv __unused)
+{
+	return 0;
 }
 
 static const struct mac_policy_ops sweet_sandbox_mac_ops = {
-- 
