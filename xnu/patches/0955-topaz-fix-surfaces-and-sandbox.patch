From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <x@x>
Date: Sat, 24 Oct 2026 20:15:00 +0300
Subject: [PATCH] topaz: disable scanout contiguous buffers and harden sandbox fallback

---
 bsd/kern/topaz_sandbox_container.c    | 37 ++++++++++++++-------------
 iokit/Kernel/arm/SweetSurface.cpp     |  4 +++
 2 files changed, 24 insertions(+), 17 deletions(-)

diff --git a/bsd/kern/topaz_sandbox_container.c b/bsd/kern/topaz_sandbox_container.c
index 1234567..2345678 100644
--- a/bsd/kern/topaz_sandbox_container.c
+++ b/bsd/kern/topaz_sandbox_container.c
@@ -53,6 +53,16 @@
 #define SANDBOX_SYSCALL_CONTAINER_PATH  4
 #define SANDBOX_CONTAINER_VARIABLE      "CFFIXED_USER_HOME="
 
+static int
+sweet_sandbox_fallback(user_addr_t buffer, user_size_t size)
+{
+	const char *fallback = "/private/var/mobile";
+	size_t flen = strlen(fallback);
+	if (flen >= size) {
+		return ENAMETOOLONG;
+	}
+	return copyout(fallback, buffer, flen + 1);
+}
+
 int
 sweet_sandbox_container_path(user_addr_t arg)
 {
@@ -79,18 +89,19 @@ sweet_sandbox_container_path(user_addr_t arg)
 	if (error) {
 		return error;
 	}
-	p = proc_find((int)args.pid);
+	if (args.pid <= 0) {
+		p = current_proc();
+		proc_ref(p);
+	} else {
+		p = proc_find((int)args.pid);
+	}
 	if (p == PROC_NULL) {
-		return ESRCH;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 	if (args.check_pidversion && (uint64_t)proc_pidversion(p) != args.pidversion) {
 		proc_rele(p);
-		return ESRCH;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 	user_stack = p->user_stack;
 	argslen = p->p_argslen;
 	task = proc_task(p);
 	if (user_stack == 0 || argslen == 0 || task == TASK_NULL) {
 		proc_rele(p);
-		const char *fallback = "/private/var/mobile";
-		size_t flen = strlen(fallback);
-		return flen < args.size ? copyout(fallback, args.buffer, flen + 1) : ENAMETOOLONG;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 	task_reference(task);
 	proc_rele(p);
 	map = get_task_map_reference(task);
 	task_deallocate(task);
 	if (map == VM_MAP_NULL) {
-		return 0;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 	strings_size = vm_map_round_page(argslen, vm_map_page_mask(map));
 	if (kmem_alloc(kernel_map, &strings, strings_size, KMA_DATA | KMA_ZERO, VM_KERN_MEMORY_BSD) != KERN_SUCCESS) {
 		vm_map_deallocate(map);
-		return ENOMEM;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 	if (vm_map_copyin(map, (vm_map_address_t)(user_stack - strings_size), strings_size, FALSE, &copy) != KERN_SUCCESS) {
 		copy = NULL;
 	}
 	vm_map_deallocate(map);
 	if (copy == NULL || vm_map_copy_overwrite(kernel_map, strings, copy, strings_size, FALSE) != KERN_SUCCESS) {
 		if (copy != NULL) {
 			vm_map_copy_discard(copy);
 		}
 		kmem_free(kernel_map, strings, strings_size);
-		return 0;
+		return sweet_sandbox_fallback(args.buffer, args.size);
 	}
 
 	end = (const char *)(strings + strings_size);
+	error = -1;
 	for (s = end - argslen; s < end; s += len + 1) {
 		len = strnlen(s, end - s);
 		if (len > prefix_len && s + len < end && strncmp(s, SANDBOX_CONTAINER_VARIABLE, prefix_len) == 0) {
 			s += prefix_len;
 			len -= prefix_len;
 			error = len < args.size ? copyout(s, args.buffer, len + 1) : ENAMETOOLONG;
 			break;
 		}
 	}
-	if (s >= end) {
-		const char *fallback = "/private/var/mobile";
-		size_t flen = strlen(fallback);
-		error = flen < args.size ? copyout(fallback, args.buffer, flen + 1) : ENAMETOOLONG;
-	}
 	kmem_free(kernel_map, strings, strings_size);
+	if (error != 0) {
+		return sweet_sandbox_fallback(args.buffer, args.size);
+	}
 	return error;
 }
diff --git a/iokit/Kernel/arm/SweetSurface.cpp b/iokit/Kernel/arm/SweetSurface.cpp
index 3456789..456789a 100644
--- a/iokit/Kernel/arm/SweetSurface.cpp
+++ b/iokit/Kernel/arm/SweetSurface.cpp
@@ -136,6 +136,8 @@
 static bool
 sweet_scanout_eligible(const SweetSurface *s)
 {
+	(void)s;
+	return false;
 	if (sweet_scanout_enabled < 0) {
 		int on = 1;
 		PE_parse_boot_argn("sweetfb_direct", &on, sizeof(on));
@@ -188,6 +190,8 @@
 static void
 sweet_res_fill(void)
 {
+	return;
 	static bool filled;
 	IOBufferMemoryDescriptor *mem[SWEET_RES_COUNT];
 	unsigned n = 0;
-- 
