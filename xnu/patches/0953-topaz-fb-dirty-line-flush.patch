From 141b0a392565761332ac9bbd710c4e4bc2ce281a Mon Sep 17 00:00:00 2001
From: test <test@test.com>
Date: Fri, 23 Oct 2026 21:12:27 +0300
Subject: [PATCH] topaz: 0953 dirty line framebuffer cache flush and skip
 unchanged lines

---
 iokit/Kernel/arm/SweetFramebuffer.cpp | 58 +++++++++++++++++++++++----
 1 file changed, 51 insertions(+), 7 deletions(-)

diff --git a/iokit/Kernel/arm/SweetFramebuffer.cpp b/iokit/Kernel/arm/SweetFramebuffer.cpp
index 1d3ee17..87c04a8 100644
--- a/iokit/Kernel/arm/SweetFramebuffer.cpp
+++ b/iokit/Kernel/arm/SweetFramebuffer.cpp
@@ -221,7 +221,7 @@ public:
 	bool          fConsShown;     /* console frames on the panel (no iOS frame yet) */
 	void          flipFrom(const uint8_t *src, uint32_t srcStride);
 	uint8_t      *backBuffer(void) { return (uint8_t *)fFlip[fFlipIdx ^ 1]->getBytesNoCopy(); }
-	void          flipBack(void);
+	void          flipBack(bool clean = true);
 	IOBufferMemoryDescriptor *fCons;    /* console shadow frame (cached, contiguous) */
 	uint64_t      fConsPhys;
 	const uint8_t *fLastVA;       /* last directly scanned frame (panel window) */
@@ -422,6 +422,10 @@ AppleCLCD::start(IOService *provider)
 			fFlip[i] = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
 			    kIODirectionInOut | kIOMemoryPhysicallyContiguous, fsz, 0x00000000fffff000ull);
 			fFlipPhys[i] = fFlip[i] ? fFlip[i]->getPhysicalSegment(0, NULL, kIOMemoryMapperNone) : 0;
+			if (fFlip[i] != NULL) {
+				bzero((void *)fFlip[i]->getBytesNoCopy(), fsz);
+				sweet_dcache_clean((vm_offset_t)(uintptr_t)fFlip[i]->getBytesNoCopy(), (unsigned)fsz);
+			}
 		}
 		fFadeOrig = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task, kIODirectionInOut, fsz, page_size);
 		fCons = IOBufferMemoryDescriptor::inTaskWithPhysicalMask(kernel_task,
@@ -1208,12 +1212,50 @@ AppleCLCD::fadeStep(const uint8_t *src, uint32_t srcStride, uint32_t step)
 	flipBack();
 }
 
-/* Clean the back buffer and point the MDP at it (latched at its vsync). */
+typedef unsigned __int128 u128;
+
+static void
+sweet_fb_copy_dirty(uint8_t *dst, const uint8_t *src, size_t len)
+{
+	size_t off = 0;
+	size_t n64 = len / 64;
+	for (size_t i = 0; i < n64; i++, off += 64) {
+		const u128 *s = (const u128 *)(src + off);
+		u128 *d = (u128 *)(dst + off);
+		u128 s0 = s[0], s1 = s[1], s2 = s[2], s3 = s[3];
+		u128 d0 = d[0], d1 = d[1], d2 = d[2], d3 = d[3];
+		if (((s0 ^ d0) | (s1 ^ d1) | (s2 ^ d2) | (s3 ^ d3)) != 0) {
+			d[0] = s0;
+			d[1] = s1;
+			d[2] = s2;
+			d[3] = s3;
+			__asm__ volatile("dc cvac, %0" :: "r"(d) : "memory");
+		}
+	}
+	size_t rem = len - off;
+	if (rem != 0) {
+		bool diff = false;
+		for (size_t j = 0; j < rem; j++) {
+			if (dst[off + j] != src[off + j]) {
+				diff = true;
+				dst[off + j] = src[off + j];
+			}
+		}
+		if (diff) {
+			__asm__ volatile("dc cvac, %0" :: "r"(dst + off) : "memory");
+		}
+	}
+}
+
 void
-AppleCLCD::flipBack(void)
+AppleCLCD::flipBack(bool clean)
 {
 	uint32_t idx = fFlipIdx ^ 1;
-	sweet_dcache_clean((vm_offset_t)(uintptr_t)fFlip[idx]->getBytesNoCopy(), (unsigned)fFlip[idx]->getLength());
+	if (clean) {
+		sweet_dcache_clean((vm_offset_t)(uintptr_t)fFlip[idx]->getBytesNoCopy(), (unsigned)fFlip[idx]->getLength());
+	} else {
+		__asm__ volatile("dsb sy" ::: "memory");
+	}
 	scanFrom(fFlipPhys[idx], fRowBytes);
 	fFlipIdx = idx;
 }
@@ -1223,13 +1265,15 @@ AppleCLCD::flipFrom(const uint8_t *src, uint32_t srcStride)
 {
 	uint8_t *dst = backBuffer();
 	if (srcStride == fRowBytes) {
-		memcpy(dst, src, (size_t)fRowBytes * fHeight);
+		sweet_fb_copy_dirty(dst, src, (size_t)fRowBytes * fHeight);
 	} else {
 		for (uint32_t y = 0; y < fHeight; y++) {
-			memcpy(dst + (uint64_t)y * fRowBytes, src + (uint64_t)y * srcStride, (size_t)fWidth * 4);
+			sweet_fb_copy_dirty(dst + (uint64_t)y * fRowBytes,
+			    src + (uint64_t)y * srcStride,
+			    (size_t)fWidth * 4);
 		}
 	}
-	flipBack();
+	flipBack(false);
 }
 
